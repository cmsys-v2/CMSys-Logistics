{
  "rules": {
    ".read": false,
    ".write": false,
    "work_orders": {
      ".read": true,
      ".write": true,
      ".indexOn": ["zone", "status", "trade", "created_at", "priority"]
    },
    "job_cards": {
      ".read": true,
      ".write": true,
      ".indexOn": ["project_id", "status", "job_number", "date", "assigned_trade"]
    },
    "daily_allocations": {
      ".read": true,
      ".write": true,
      ".indexOn": ["date", "sailor_id", "official_number", "trade", "zone"]
    },
    "sailors": {
      ".read": true,
      ".write": true,
      ".indexOn": ["official_number", "trade", "category", "status", "current_zone", "isZoneTeam"]
    },
    "availability": {
      ".read": true,
      ".write": true,
      ".indexOn": ["official_number", "type", "date", "from_date", "to_date", "status"]
    },
    "special_projects": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "code", "category", "status", "start_date", "end_date"]
    },
    "naval_projects": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "code", "voteNumber", "status", "priority", "projectType", "startDate", "endDate"]
    },
    "procurement_files": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "projectId", "projectCode", "voteNumber", "prNumber", "presentPosition", "supplier", "date"]
    },
    "special_project_attachments": {
      ".read": true,
      ".write": true,
      ".indexOn": ["project_id", "official_number", "trade", "status", "from_date", "to_date"]
    },
    "attachments": {
      ".read": true,
      ".write": true,
      ".indexOn": ["project_id", "official_number", "trade", "status"]
    },
    "out_projects": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "name", "status", "zone"]
    },
    "housing_projects": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "name", "status", "zone"]
    },
    "other_bases": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "name", "status"]
    },
    "inventory": {
      ".read": true,
      ".write": true,
      ".indexOn": ["item_code", "category", "zone_id", "status"]
    },
    "inventory_purchase_origins": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "source"]
    },
    "stock_transactions": {
      ".read": true,
      ".write": true,
      ".indexOn": ["item_code", "transaction_type", "date"]
    },
    "locations": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "zone", "name"]
    },
    "estimates": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "status", "created_at"]
    },
    "maintenance_records": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "status", "equipment_id"]
    },
    "approved_projects": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "status"]
    },
    "precast_batches": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "batch_number", "status"]
    },
    "temp_issues": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "date"]
    },
    "temp_drafts": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "created_at"]
    },
    "board_entries": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "date"]
    },
    "performance_awards": {
      ".read": true,
      ".write": true,
      ".indexOn": ["official_number", "date"]
    },
    "approved_pending_jobs": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id", "status"]
    },
    "cmsys_logistics_sync": {
      ".read": true,
      ".write": true,
      ".indexOn": ["synced_at"]
    },
    "settings": {
      ".read": true,
      ".write": true,
      ".indexOn": ["updated_at"]
    },
    "leave_requests": {
      ".read": true,
      ".write": true,
      ".indexOn": ["official_number", "status", "from_date"]
    },
    "nav254_vouchers": {
      ".read": true,
      ".write": true,
      ".indexOn": ["voucher_no", "issuing_unit", "receiving_unit", "date"]
    },
    "logistics": {
      ".read": true,
      ".write": true,
      "projects": {
        ".indexOn": ["id", "vote", "status"]
      },
      "storeitems": {
        ".indexOn": ["id", "zone", "category"]
      },
      "procurementfiles": {
        ".indexOn": ["id", "fileNumber", "status"]
      }
    },
    "document_registry": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "id",
        "office_section",
        "flow_type",
        "ref_no",
        "file_no",
        "date_recorded",
        "date_letter",
        "present_position",
        "directed_to",
        "directed_type",
        "project_id",
        "priority",
        "status"
      ]
    },
    "job_minutes": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "id",
        "ref_no",
        "directed_to",
        "directed_type",
        "project_id",
        "date_received",
        "position",
        "priority"
      ]
    },
    "naval_letters": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "id",
        "letter_ref",
        "file_no",
        "letter_date",
        "security_class",
        "precedence",
        "br7_tone",
        "status",
        "is_registered_outgoing"
      ]
    },
    "file_registry": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "id",
        "file_no",
        "office_section",
        "category",
        "status"
      ]
    },
    "registry_prefixes": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "id",
        "office_section",
        "category",
        "flow_type",
        "is_default"
      ]
    },
    "minute_templates": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "id",
        "category",
        "lang"
      ]
    },
    "naval_letter_templates": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "id",
        "category",
        "security_class",
        "br7_tone"
      ]
    },
    "system_settings": {
      ".read": true,
      ".write": true,
      ".indexOn": ["updated_at"]
    },
    "system_status": {
      ".read": true,
      ".write": true,
      ".indexOn": ["system", "version", "last_sync", "status"]
    },
    "weather_logs": {
      ".read": true,
      ".write": true,
      ".indexOn": ["project_id", "date"]
    },
    "officers": {
      ".read": true,
      ".write": true,
      ".indexOn": ["official_number", "id", "name", "rank", "directorate", "department"]
    },
    "user_profiles": {
      ".read": true,
      ".write": true,
      ".indexOn": ["official_number", "id", "name", "role", "username", "department"]
    },
    "cmsys_absorption": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status", "timestamp"]
    },
    "cmsys_absorption_history": {
      ".read": true,
      ".write": true,
      ".indexOn": ["published_at"]
    }
  }
}
